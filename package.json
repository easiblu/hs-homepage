{
  "name": "hs-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HeartStamp marketing homepage \u2014 React port of HeartStamp Home v5.7",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "port:template": "node tools/convert-template.cjs",
    "port:assemble": "node tools/assemble-home.cjs",
    "port": "npm run port:template && npm run port:assemble"
  },
  "dependencies": {
    "@heartstampxo/design-system": "^2.1.59",
    "lenis": "1.1.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.0",
    "vite": "6.3.5",
    "jsdom": "^26.0.0"
  }
}
